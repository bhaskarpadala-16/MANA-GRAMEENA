# ==========================================
# MANA GRAMEENA - ENVIRONMENT CONFIGURATION
# ==========================================

# 1. DATABASE (Supabase PostgreSQL via Prisma 7 & pg driver adapter)
# Transaction pooler URL (Port 6543) for application queries:
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection URL (Port 5432) for migrations:
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# 2. SUPABASE API & STORAGE (Current Standard Key Architecture)
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
# Browser-safe publishable key:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="pk_..."

# Server-only secret key (CRITICAL: NEVER EXPOSE TO BROWSER / CLIENT BUNDLES):
SUPABASE_SECRET_KEY="sk_..."

# 3. STORE & MANUAL PAYMENT DETAILS
NEXT_PUBLIC_STORE_NAME="Mana Grameena"
NEXT_PUBLIC_STORE_TAGLINE="Authentic Homemade Herbal & Wellness Essentials"
UPI_ID="merchant@upi"
UPI_NAME="Mana Grameena"

# 4. NOTIFICATIONS & EMAIL (Configurable)
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM="orders@managrameena.com"
